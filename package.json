{
  "name": "looma-monorepo",
  "private": true,
  "version": "0.12.6",
  "description": "Stack-agnostic UI library built on web standards and Open UI principles.",
  "license": "MIT",
  "author": "Threadlabs Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadlabs-studio/looma.git"
  },
  "bugs": {
    "url": "https://github.com/threadlabs-studio/looma/issues"
  },
  "homepage": "https://github.com/threadlabs-studio/looma#readme",
  "keywords": [
    "looma",
    "declarative-components",
    "ui",
    "design-system"
  ],
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @threadlabs/looma build && pnpm -r --filter './apps/**' run build",
    "build:docs": "pnpm --filter @threadlabs/looma-docs build",
    "build:storybook": "pnpm --filter @threadlabs/looma-storybook build",
    "check:code-documentation": "node ./tools/scripts/check-code-documentation.mjs --check",
    "check:mutation-observer": "node ./tools/scripts/check-mutation-observer.mjs",
    "dev:docs": "pnpm --filter @threadlabs/looma-docs dev",
    "dev:storybook": "pnpm --filter @threadlabs/looma-storybook dev",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "generate:api": "node ./tools/scripts/generate-component-api.mjs",
    "generate:docs": "pnpm generate:api",
    "lint": "pnpm -r run lint",
    "release:inspect": "node tools/scripts/verify-packages.mjs --output-dir .release/artifacts --allow-dirty --allow-missing-license",
    "release:registry-preflight": "node tools/scripts/registry-preflight.mjs",
    "release:verify": "node tools/scripts/verify-packages.mjs --output-dir .release/artifacts && pnpm test:facade-consumer",
    "release:verify-public-consumer": "node tools/scripts/verify-public-consumer.mjs",
    "release:verify-registry": "node tools/scripts/verify-registry-release.mjs",
    "release:verify:dirty": "node tools/scripts/verify-packages.mjs --output-dir .release/artifacts --allow-dirty",
    "test": "node --test tools/scripts/*.test.mjs && pnpm --filter @threadlabs/looma build && pnpm -r run test",
    "test:browser": "pnpm --filter @threadlabs/looma test:browser && pnpm --filter @threadlabs/looma-docs test:browser",
    "test:facade-consumer": "node tools/scripts/verify-facade-consumer.mjs",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "verdaccio": "6.8.0",
    "dprint": "^0.57.4"
  },
  "pnpm": {
    "overrides": {
      "prosemirror-model": "1.25.11",
      "prosemirror-transform": "1.12.0",
      "prosemirror-view": "1.42.3"
    }
  }
}
