{
  "name": "looma-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Stack-agnostic UI library built on web standards and Open UI principles.",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "generate:api": "node ./tools/scripts/generate-component-api.mjs",
    "generate:docs": "pnpm generate:api",
    "check:docs-sync": "node ./tools/scripts/check-docs-sync.mjs",
    "check:mutation-observer": "node ./tools/scripts/check-mutation-observer.mjs",
    "dev:docs": "pnpm --filter @looma/docs dev",
    "dev:storybook": "pnpm --filter @looma/storybook dev",
    "build:docs": "pnpm --filter @looma/docs build",
    "build:storybook": "pnpm --filter @looma/storybook build",
    "lint": "pnpm -r run lint",
    "release:registry-preflight": "node tools/scripts/registry-preflight.mjs",
    "release:inspect": "node tools/scripts/verify-packages.mjs --output-dir .release/artifacts --allow-dirty --allow-missing-license --allow-missing-approvals",
    "release:verify": "node tools/scripts/verify-packages.mjs --output-dir .release/artifacts",
    "release:verify:dirty": "node tools/scripts/verify-packages.mjs --output-dir .release/artifacts --allow-dirty",
    "test": "node --test tools/scripts/*.test.mjs && pnpm build && pnpm -r run test",
    "test:browser": "pnpm --filter @looma/core test:browser && pnpm --filter @looma/editor test:browser && pnpm --filter @looma/vue test:browser && pnpm --filter @looma/docs test:browser",
    "typecheck": "pnpm -r run typecheck"
  }
}
