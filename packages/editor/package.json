{
  "name": "@threadlabs/looma-editor",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "description": "Open-source Tiptap editor behavior, UI elements, styles, presets, and table kit for Looma.",
  "license": "MIT",
  "author": "Threadlabs Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadlabs-studio/looma.git",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/threadlabs-studio/looma#readme",
  "bugs": {
    "url": "https://github.com/threadlabs-studio/looma/issues"
  },
  "files": [
    "dist/",
    "src/editor.css",
    "README.md"
  ],
  "sideEffects": [
    "./dist/*.js",
    "./src/editor.css",
    "./dist/editor.css",
    "./src/*.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./editor.css": "./src/editor.css"
  },
  "scripts": {
    "build": "tsup",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@threadlabs/looma-core": "workspace:*",
    "@threadlabs/looma-tokens": "workspace:*",
    "lowlight": "^3.3.0"
  },
  "peerDependencies": {
    "@tiptap/core": ">=2 <3",
    "@tiptap/extension-blockquote": ">=2 <3",
    "@tiptap/extension-bold": ">=2 <3",
    "@tiptap/extension-bullet-list": ">=2 <3",
    "@tiptap/extension-code": ">=2 <3",
    "@tiptap/extension-code-block-lowlight": ">=2 <3",
    "@tiptap/extension-document": ">=2 <3",
    "@tiptap/extension-dropcursor": ">=2 <3",
    "@tiptap/extension-gapcursor": ">=2 <3",
    "@tiptap/extension-hard-break": ">=2 <3",
    "@tiptap/extension-heading": ">=2 <3",
    "@tiptap/extension-highlight": ">=2 <3",
    "@tiptap/extension-history": ">=2 <3",
    "@tiptap/extension-horizontal-rule": ">=2 <3",
    "@tiptap/extension-image": ">=2 <3",
    "@tiptap/extension-italic": ">=2 <3",
    "@tiptap/extension-link": ">=2 <3",
    "@tiptap/extension-list-item": ">=2 <3",
    "@tiptap/extension-ordered-list": ">=2 <3",
    "@tiptap/extension-paragraph": ">=2 <3",
    "@tiptap/extension-placeholder": ">=2 <3",
    "@tiptap/extension-strike": ">=2 <3",
    "@tiptap/extension-table": ">=2 <3",
    "@tiptap/extension-table-cell": ">=2 <3",
    "@tiptap/extension-table-header": ">=2 <3",
    "@tiptap/extension-table-row": ">=2 <3",
    "@tiptap/extension-task-item": ">=2 <3",
    "@tiptap/extension-task-list": ">=2 <3",
    "@tiptap/extension-text": ">=2 <3",
    "@tiptap/extension-typography": ">=2 <3",
    "@tiptap/extension-underline": ">=2 <3",
    "@tiptap/pm": ">=2 <3",
    "@tiptap/suggestion": ">=2 <3"
  },
  "devDependencies": {
    "@vitest/browser": "~3.2.6",
    "axe-core": "^4.10.3",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-blockquote": "^2.11.5",
    "@tiptap/extension-bold": "^2.11.5",
    "@tiptap/extension-bullet-list": "^2.11.5",
    "@tiptap/extension-code": "^2.11.5",
    "@tiptap/extension-code-block-lowlight": "^2.11.5",
    "@tiptap/extension-document": "^2.11.5",
    "@tiptap/extension-dropcursor": "^2.11.5",
    "@tiptap/extension-gapcursor": "^2.11.5",
    "@tiptap/extension-hard-break": "^2.11.5",
    "@tiptap/extension-heading": "^2.11.5",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-history": "^2.11.5",
    "@tiptap/extension-horizontal-rule": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-italic": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-list-item": "^2.11.5",
    "@tiptap/extension-ordered-list": "^2.11.5",
    "@tiptap/extension-paragraph": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-strike": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-text": "^2.11.5",
    "@tiptap/extension-typography": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/suggestion": "^2.11.5",
    "jsdom": "^27.0.0",
    "playwright": "~1.60.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  }
}
