{
  "name": "@looma/editor",
  "version": "0.0.0",
  "type": "module",
  "description": "Confluence/Notion-like editor UI as web components: slash menu, tables, block menu, toolbar. Vue/React adapters in @looma/vue / @looma/react.",
  "sideEffects": [
    "./dist/editor.css",
    "./src/editor.css",
    "**/*.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./editor.css": "./src/editor.css"
  },
  "scripts": {
    "build": "tsup src/index.ts src/extensions/index.ts --format esm --dts --clean",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@looma/core": "workspace:*",
    "@looma/tokens": "workspace:*",
    "prosemirror-tables": "^1.8.5"
  },
  "peerDependencies": {
    "@tiptap/core": ">=2.0.0",
    "@tiptap/extension-blockquote": ">=2.0.0",
    "@tiptap/extension-bold": ">=2.0.0",
    "@tiptap/extension-bullet-list": ">=2.0.0",
    "@tiptap/extension-code": ">=2.0.0",
    "@tiptap/extension-code-block": ">=2.0.0",
    "@tiptap/extension-document": ">=2.0.0",
    "@tiptap/extension-dropcursor": ">=2.0.0",
    "@tiptap/extension-gapcursor": ">=2.0.0",
    "@tiptap/extension-hard-break": ">=2.0.0",
    "@tiptap/extension-heading": ">=2.0.0",
    "@tiptap/extension-highlight": ">=2.0.0",
    "@tiptap/extension-history": ">=2.0.0",
    "@tiptap/extension-horizontal-rule": ">=2.0.0",
    "@tiptap/extension-image": ">=2.0.0",
    "@tiptap/extension-italic": ">=2.0.0",
    "@tiptap/extension-link": ">=2.0.0",
    "@tiptap/extension-list-item": ">=2.0.0",
    "@tiptap/extension-ordered-list": ">=2.0.0",
    "@tiptap/extension-paragraph": ">=2.0.0",
    "@tiptap/extension-placeholder": ">=2.0.0",
    "@tiptap/extension-strike": ">=2.0.0",
    "@tiptap/extension-table": ">=2.0.0",
    "@tiptap/extension-table-cell": ">=2.0.0",
    "@tiptap/extension-table-header": ">=2.0.0",
    "@tiptap/extension-table-row": ">=2.0.0",
    "@tiptap/extension-task-item": ">=2.0.0",
    "@tiptap/extension-task-list": ">=2.0.0",
    "@tiptap/extension-text": ">=2.0.0",
    "@tiptap/extension-typography": ">=2.0.0",
    "@tiptap/extension-underline": ">=2.0.0"
  },
  "devDependencies": {
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-blockquote": "^2.11.5",
    "@tiptap/extension-bold": "^2.11.5",
    "@tiptap/extension-bullet-list": "^2.11.5",
    "@tiptap/extension-code": "^2.11.5",
    "@tiptap/extension-code-block": "^2.27.2",
    "@tiptap/extension-document": "^2.11.5",
    "@tiptap/extension-dropcursor": "^2.11.5",
    "@tiptap/extension-gapcursor": "^2.11.5",
    "@tiptap/extension-hard-break": "^2.11.5",
    "@tiptap/extension-heading": "^2.11.5",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-history": "^2.11.5",
    "@tiptap/extension-horizontal-rule": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-italic": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-list-item": "^2.11.5",
    "@tiptap/extension-ordered-list": "^2.11.5",
    "@tiptap/extension-paragraph": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-strike": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-text": "^2.11.5",
    "@tiptap/extension-typography": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
