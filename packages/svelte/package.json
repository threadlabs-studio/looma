{
  "name": "@threadlabs/looma-svelte",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "description": "Thin Svelte helpers for Looma web components.",
  "license": "MIT",
  "author": "Threadlabs Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadlabs-studio/looma.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/threadlabs-studio/looma/issues"
  },
  "homepage": "https://github.com/threadlabs-studio/looma/tree/main/packages/svelte#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"svelte adapter: tests not configured yet\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@threadlabs/looma-core": "workspace:*",
    "@threadlabs/looma-layout": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
