{
  "name": "@threadlabs/looma-vue",
  "version": "0.1.8",
  "private": true,
  "description": "Supported Vue 3 adapters and the turnkey Looma Tiptap editor.",
  "type": "module",
  "license": "MIT",
  "author": "Threadlabs Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadlabs-studio/looma.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/threadlabs-studio/looma#readme",
  "bugs": {
    "url": "https://github.com/threadlabs-studio/looma/issues"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/editor/index.ts --format esm --dts --clean",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@threadlabs/looma-core": "workspace:*",
    "@threadlabs/looma-editor": "workspace:*",
    "@threadlabs/looma-layout": "workspace:*"
  },
  "peerDependencies": {
    "@tiptap/core": ">=2 <3",
    "@tiptap/vue-3": ">=2 <3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitest/browser": "~3.2.6",
    "@tiptap/core": "^2.11.5",
    "@tiptap/vue-3": "^2.11.5",
    "jsdom": "^26.1.0",
    "playwright": "~1.60.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  }
}
