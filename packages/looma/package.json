{
  "name": "@threadlabs/looma",
  "version": "0.52.0",
  "type": "module",
  "description": "HTML Next UI components, native DOM support and design tokens.",
  "license": "MIT",
  "author": "Threadlabs Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadlabs-studio/looma.git",
    "directory": "packages/looma"
  },
  "homepage": "https://github.com/threadlabs-studio/looma#readme",
  "bugs": {
    "url": "https://github.com/threadlabs-studio/looma/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "html-next": "./components/",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./editor/index.d.ts",
      "import": "./editor/index.js",
      "default": "./editor/index.js"
    },
    "./editor/ui": {
      "types": "./editor/ui.d.ts",
      "import": "./editor/ui.js",
      "default": "./editor/ui.js"
    },
    "./editor/extensions": {
      "types": "./editor/extensions/index.d.ts",
      "import": "./editor/extensions/index.js",
      "default": "./editor/extensions/index.js"
    },
    "./markdown": {
      "types": "./markdown/index.d.ts",
      "import": "./markdown/index.js",
      "default": "./markdown/index.js"
    },
    "./markdown/fixtures": {
      "types": "./markdown/fixtures.d.ts",
      "import": "./markdown/fixtures.js",
      "default": "./markdown/fixtures.js"
    },
    "./vanilla": "./vanilla/index.js",
    "./vanilla/*": "./vanilla/*",
    "./components/*": "./components/*",
    "./tokens.css": "./tokens.css",
    "./theme-light.css": "./theme-light.css",
    "./theme-dark.css": "./theme-dark.css",
    "./theme-high-contrast.css": "./theme-high-contrast.css",
    "./editor/expressmark": {
      "types": "./editor/expressmark.d.ts",
      "import": "./editor/expressmark.js",
      "default": "./editor/expressmark.js"
    },
    "./theme-system.css": "./theme-system.css",
    "./docs/catalog.json": "./docs/catalog.json",
    "./editor/compact": {
      "types": "./editor/compact.d.ts",
      "import": "./editor/compact.js",
      "default": "./editor/compact.js"
    },
    "./editor.css": "./editor/components.css",
    "./input-modality": {
      "types": "./components/shared/input-modality.d.ts",
      "import": "./components/shared/input-modality.js",
      "default": "./components/shared/input-modality.js"
    },
    "./docs/examples/*": "./docs/examples/*"
  },
  "files": [
    "dist/",
    "editor/",
    "markdown/",
    "vanilla/",
    "components/",
    "styles/",
    "*.css",
    "README.md",
    "LICENSE",
    "EXPRESSIVE-MARKDOWN.md",
    "docs/"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./vanilla/*.js",
    "**/*.css"
  ],
  "scripts": {
    "build": "node build.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/run-browser.mjs"
  },
  "dependencies": {
    "@nextwebwg/html-next": ">=1.0.0-alpha.82",
    "@js-temporal/polyfill": "^0.5.1",
    "dompurify": "3.4.15",
    "expressmark": ">=0.5.1",
    "highlight.js": "11.11.2",
    "lowlight": "^3.3.0",
    "lucide": "~0.554.0"
  },
  "peerDependencies": {
    "@tiptap/core": ">=2 <3",
    "@tiptap/pm": ">=2 <3"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/compiler-cli": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/platform-browser": "21.2.24",
    "@angular/platform-server": "21.2.24",
    "@nextwebwg/html-next-unplugin": ">=1.0.0-alpha.82",
    "@preact/preset-vite": "^2.10.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-blockquote": "^2.11.5",
    "@tiptap/extension-bold": "^2.11.5",
    "@tiptap/extension-bullet-list": "^2.11.5",
    "@tiptap/extension-code": "^2.11.5",
    "@tiptap/extension-code-block-lowlight": "^2.11.5",
    "@tiptap/extension-document": "^2.11.5",
    "@tiptap/extension-dropcursor": "^2.11.5",
    "@tiptap/extension-gapcursor": "^2.11.5",
    "@tiptap/extension-hard-break": "^2.11.5",
    "@tiptap/extension-heading": "^2.11.5",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-history": "^2.11.5",
    "@tiptap/extension-horizontal-rule": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-italic": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-list-item": "^2.11.5",
    "@tiptap/extension-mention": "^2.11.5",
    "@tiptap/extension-ordered-list": "^2.11.5",
    "@tiptap/extension-paragraph": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-strike": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-text": "^2.11.5",
    "@tiptap/extension-typography": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/suggestion": "^2.11.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser-playwright": "^5.0.4",
    "axe-core": "^4.10.3",
    "jsdom": "^27.0.0",
    "playwright": "~1.60.0",
    "preact": "^11.1.0",
    "preact-render-to-string": "^6.8.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11",
    "parse5": "^8.0.1"
  },
  "engines": {
    "node": ">=22.22.2 <23 || >=24.15 <25"
  }
}
