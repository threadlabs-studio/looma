{
  "name": "@threadlabs/looma",
  "version": "0.11.6",
  "type": "module",
  "description": "Looma components as HTML, Vue, and plain DOM, with design tokens.",
  "license": "MIT",
  "author": "Threadlabs Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadlabs-studio/looma.git",
    "directory": "packages/looma"
  },
  "homepage": "https://github.com/threadlabs-studio/looma#readme",
  "bugs": {
    "url": "https://github.com/threadlabs-studio/looma/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./vue/index.d.ts",
      "import": "./vue/index.js",
      "default": "./vue/index.js"
    },
    "./vue.css": "./vue/components.css",
    "./vue/editor": {
      "types": "./vue/editor/index.d.ts",
      "import": "./vue/editor/index.js",
      "default": "./vue/editor/index.js"
    },
    "./editor": {
      "types": "./editor/index.d.ts",
      "import": "./editor/index.js",
      "default": "./editor/index.js"
    },
    "./editor/ui": {
      "types": "./editor/ui.d.ts",
      "import": "./editor/ui.js",
      "default": "./editor/ui.js"
    },
    "./editor/extensions": {
      "types": "./editor/extensions/index.d.ts",
      "import": "./editor/extensions/index.js",
      "default": "./editor/extensions/index.js"
    },
    "./vue/*": "./vue/*",
    "./vanilla": "./vanilla/index.js",
    "./vanilla/*": "./vanilla/*",
    "./components/*": "./components/*",
    "./tokens.css": "./tokens.css",
    "./theme-light.css": "./theme-light.css",
    "./theme-dark.css": "./theme-dark.css",
    "./theme-high-contrast.css": "./theme-high-contrast.css"
  },
  "files": [
    "dist/",
    "vue/",
    "editor/",
    "vanilla/",
    "components/",
    "styles/",
    "*.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./vanilla/*.js",
    "./styles/*.css",
    "./*.css"
  ],
  "scripts": {
    "build": "node build.mjs",
    "lint": "vue-tsc -p tsconfig.json --noEmit",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run && vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@nextwebwg/html-next": "^1.0.0-alpha.5",
    "lowlight": "^3.3.0",
    "markdown-it": "14.3.1",
    "lucide": "~0.554.0"
  },
  "peerDependencies": {
    "@tiptap/core": ">=2 <3",
    "@tiptap/pm": ">=2 <3",
    "@tiptap/vue-3": ">=2 <3",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/vue-3": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^8.3.0",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11",
    "typescript": "~5.9.3",
    "playwright": "~1.60.0",
    "vitest": "^3.2.6",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-blockquote": "^2.11.5",
    "@tiptap/extension-bold": "^2.11.5",
    "@tiptap/extension-bullet-list": "^2.11.5",
    "@tiptap/extension-code": "^2.11.5",
    "@tiptap/extension-code-block-lowlight": "^2.11.5",
    "@tiptap/extension-document": "^2.11.5",
    "@tiptap/extension-dropcursor": "^2.11.5",
    "@tiptap/extension-gapcursor": "^2.11.5",
    "@tiptap/extension-hard-break": "^2.11.5",
    "@tiptap/extension-heading": "^2.11.5",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-history": "^2.11.5",
    "@tiptap/extension-horizontal-rule": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-italic": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-list-item": "^2.11.5",
    "@tiptap/extension-mention": "^2.11.5",
    "@tiptap/extension-ordered-list": "^2.11.5",
    "@tiptap/extension-paragraph": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-strike": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-text": "^2.11.5",
    "@tiptap/extension-typography": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/suggestion": "^2.11.5",
    "@tiptap/vue-3": "^2.11.5",
    "@types/markdown-it": "14.2.0",
    "@vitest/browser": "~3.2.6",
    "jsdom": "^27.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
