{
  "name": "@threadlabs/looma",
  "version": "0.1.13",
  "type": "module",
  "description": "Looma web components, responsive layout primitives, a complete editor, and supported Vue adapters.",
  "license": "MIT",
  "author": "Threadlabs Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadlabs-studio/looma.git",
    "directory": "packages/looma"
  },
  "homepage": "https://github.com/threadlabs-studio/looma#readme",
  "bugs": {
    "url": "https://github.com/threadlabs-studio/looma/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js"
    },
    "./layout": {
      "types": "./layout/index.d.ts",
      "import": "./layout/index.js",
      "require": "./layout/index.cjs"
    },
    "./editor": {
      "types": "./editor/index.d.ts",
      "import": "./editor/index.js"
    },
    "./editor/ui": {
      "types": "./editor/ui.d.ts",
      "import": "./editor/ui.js"
    },
    "./editor/extensions": {
      "types": "./editor/extensions/index.d.ts",
      "import": "./editor/extensions/index.js"
    },
    "./vue": {
      "types": "./vue/index.d.ts",
      "import": "./vue/index.js"
    },
    "./vue/editor": {
      "types": "./vue/editor/index.d.ts",
      "import": "./vue/editor/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./theme-light.css": "./theme-light.css",
    "./theme-dark.css": "./theme-dark.css",
    "./theme-high-contrast.css": "./theme-high-contrast.css",
    "./layout.css": "./layout.css",
    "./styles.css": "./styles.css",
    "./editor.css": "./editor.css"
  },
  "files": [
    "dist/",
    "loader/",
    "layout/",
    "editor/",
    "vue/",
    "tokens.css",
    "theme-light.css",
    "theme-dark.css",
    "theme-high-contrast.css",
    "layout.css",
    "styles.css",
    "editor.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./layout/index.js",
    "./editor/*.js",
    "./vue/index.js",
    "./vue/editor/*.js",
    "./*.css"
  ],
  "scripts": {
    "build": "node ../../tools/scripts/build-facade.mjs",
    "test": "node --test ../../tools/scripts/facade-*.test.mjs",
    "typecheck": "node ../../tools/scripts/verify-facade.mjs --definition-only"
  },
  "dependencies": {
    "lucide": "~0.554.0",
    "lowlight": "^3.3.0"
  },
  "peerDependencies": {
    "@tiptap/core": ">=2 <3",
    "@tiptap/pm": ">=2 <3",
    "@tiptap/vue-3": ">=2 <3",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": { "optional": true },
    "@tiptap/pm": { "optional": true },
    "@tiptap/vue-3": { "optional": true },
    "vue": { "optional": true }
  },
  "engines": {
    "node": ">=20"
  }
}
