{
  "name": "@threadlabs/looma",
  "version": "0.4.0",
  "type": "module",
  "description": "Looma components as HTML, Vue, and plain DOM, with design tokens.",
  "license": "MIT",
  "author": "Threadlabs Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadlabs-studio/looma.git",
    "directory": "packages/looma"
  },
  "homepage": "https://github.com/threadlabs-studio/looma#readme",
  "bugs": {
    "url": "https://github.com/threadlabs-studio/looma/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./vue/index.d.ts",
      "import": "./vue/index.js"
    },
    "./vue.css": "./vue/components.css",
    "./vue/*": "./vue/*",
    "./vanilla": "./vanilla/index.js",
    "./vanilla/*": "./vanilla/*",
    "./components/*": "./components/*",
    "./tokens.css": "./tokens.css",
    "./theme-light.css": "./theme-light.css",
    "./theme-dark.css": "./theme-dark.css",
    "./theme-high-contrast.css": "./theme-high-contrast.css"
  },
  "files": [
    "dist/",
    "vue/",
    "vanilla/",
    "components/",
    "styles/",
    "*.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./vanilla/*.js",
    "./styles/*.css",
    "./*.css"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@nextwebwg/declarative-components": "file:../../../../nextwebwg/html-next/.release/nextwebwg-declarative-components-1.0.0-alpha.1.tgz"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^8.3.0",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11",
    "typescript": "~5.9.3",
    "playwright": "~1.60.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  }
}
