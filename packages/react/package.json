{
  "name": "@threadlabs/looma-react",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "description": "React adapters generated from Looma declarative component contracts.",
  "license": "MIT",
  "author": "Threadlabs Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadlabs-studio/looma.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/threadlabs-studio/looma/issues"
  },
  "homepage": "https://github.com/threadlabs-studio/looma/tree/main/packages/react#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@threadlabs/looma-core": "workspace:*",
    "@threadlabs/looma-editor": "workspace:*",
    "@threadlabs/looma-layout": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "jsdom": "^27.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.6"
  }
}
