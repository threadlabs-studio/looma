{
  "name": "@threadlabs/looma-core",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "description": "SSR-first Looma web components with semantic light-DOM fallback contracts.",
  "license": "MIT",
  "author": "Threadlabs Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadlabs-studio/looma.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/threadlabs-studio/looma#readme",
  "bugs": {
    "url": "https://github.com/threadlabs-studio/looma/issues"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist/",
    "loader/",
    "src/styles.css",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../tools/scripts/run-stencil-build.mjs && tsup index.ts --format esm,cjs --dts --outDir dist",
    "start": "stencil build --dev --watch --serve",
    "test": "pnpm build && vitest run",
    "test:browser": "pnpm build && vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc -p tsconfig.stencil.json --noEmit"
  },
  "devDependencies": {
    "@stencil/core": "^4.27.1",
    "@types/node": "^22.13.5",
    "@vitest/browser": "~3.2.6",
    "axe-core": "^4.10.3",
    "jsdom": "^27.0.0",
    "playwright": "~1.60.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  }
}
