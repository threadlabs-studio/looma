{
  "name": "@looma/core",
  "version": "0.0.0",
  "type": "module",
  "description": "Looma UI primitives built with Stencil",
  "license": "MIT",
  "author": "Threadlabs Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadlabs-studio/looma.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/threadlabs-studio/looma/issues"
  },
  "homepage": "https://github.com/threadlabs-studio/looma/tree/main/packages/core#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist/",
    "loader/",
    "src/styles.css"
  ],
  "scripts": {
    "build": "stencil build && tsup src/index.ts --format esm,cjs --dts --outDir dist",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@stencil/core": "^4.27.1",
    "tsup": "^8.5.0",
    "@types/node": "^22.13.5",
    "typescript": "^5.9.2"
  }
}
