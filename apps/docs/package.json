{
  "name": "@threadlabs/looma-docs",
  "private": true,
  "version": "0.25.0",
  "scripts": {
    "dev": "pnpm generate:api && docusaurus start --port 4173",
    "build": "pnpm generate:api && BROWSERSLIST_IGNORE_OLD_DATA=true docusaurus build",
    "generate:api": "pnpm --dir ../.. generate:api",
    "lint": "echo \"docs: lint not configured\"",
    "test": "echo \"docs: run test:parity and test:visual for browser checks\"",
    "test:browser": "playwright test --workers=1 --project=chromium",
    "test:parity": "playwright test --workers=1 --project=chromium --project=firefox --project=webkit",
    "test:visual": "node scripts/browser.mjs visual",
    "test:parity:container": "node scripts/browser.mjs behavior",
    "typecheck:tests": "tsc --project tsconfig.tests.json",
    "docs:coverage": "node ../../tools/scripts/docs-coverage.mjs",
    "docs:coverage:update": "node ../../tools/scripts/docs-coverage.mjs --write",
    "typecheck": "echo \"docs: typecheck not configured\""
  },
  "dependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/plugin-content-docs": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@mdx-js/react": "^3.1.0",
    "@threadlabs/looma": "workspace:*",
    "@tiptap/core": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/vue-3": "^2.11.5",
    "prismjs": "^1.30.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.9.2",
    "@playwright/test": "~1.60.0",
    "@types/node": "^22.15.30",
    "axe-core": "^4.10.3",
    "typescript": "^5.9.2"
  }
}
