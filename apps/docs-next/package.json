{
  "name": "@threadlabs/looma-docs-next",
  "private": true,
  "version": "0.28.0",
  "type": "module",
  "scripts": {
    "dev": "looma-docs dev",
    "build": "looma-docs build",
    "preview": "looma-docs preview",
    "lint": "echo \"docs-next: lint not configured\"",
    "test": "node scripts/check-copies.mjs && node --test scripts/*.test.mjs",
    "test:homepage": "playwright test --config playwright.homepage.config.js --workers=1",
    "test:safari": "playwright test --config playwright.safari.config.js --workers=1",
    "test:parity": "playwright test",
    "typecheck": "echo \"docs-next: typecheck not configured\""
  },
  "dependencies": {
    "@nextwebwg/html-next": ">=1.0.0-alpha.90",
    "@threadlabs/looma": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "~1.60.0",
    "@threadlabs/looma-docs": "workspace:*",
    "markupress": ">=0.18.4"
  }
}
