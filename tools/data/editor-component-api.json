{
  "components": [
    {
      "tag": "ui-editor-insert-table-grid",
      "package": "@threadlabs/looma/editor",
      "className": "UIEditorInsertTableGridElement",
      "description": "Keyboard- and pointer-operable grid for selecting table dimensions before insertion.",
      "attributes": [
        { "name": "max-cols", "property": "maxCols", "type": "number", "default": 8 },
        { "name": "max-rows", "property": "maxRows", "type": "number", "default": 8 },
        { "name": "open", "property": "open", "type": "boolean", "default": false }
      ],
      "properties": [],
      "events": [
        {
          "name": "looma-editor-insert-table",
          "detailType": "InsertTableEventDetail",
          "detailSchema": "{ rows: number; cols: number; withHeaderRow: boolean }",
          "detailDocs": "Emitted when the user confirms the selected table dimensions."
        }
      ],
      "slots": []
    },
    {
      "tag": "ui-editor-mention-menu",
      "package": "@threadlabs/looma/editor",
      "className": "UIEditorMentionMenuElement",
      "description": "Bounded, accessible people-suggestion surface positioned from an editor mention anchor.",
      "attributes": [],
      "properties": [
        { "name": "anchorRect", "type": "DOMRect | null", "default": null },
        { "name": "items", "type": "LoomaMentionItem[]", "default": [] },
        { "name": "loading", "type": "boolean", "default": false },
        { "name": "open", "type": "boolean", "default": false },
        { "name": "query", "type": "string", "default": "" },
        { "name": "selectedIndex", "type": "number", "default": 0 }
      ],
      "events": [
        {
          "name": "looma-editor-mention-menu-highlight",
          "detailType": "MentionMenuHighlightEventDetail",
          "detailSchema": "{ index: number }",
          "detailDocs": "Emitted when pointer navigation changes the highlighted person."
        },
        {
          "name": "looma-editor-mention-menu-select",
          "detailType": "MentionMenuSelectEventDetail",
          "detailSchema": "{ index: number }",
          "detailDocs": "Emitted when the user selects a person."
        }
      ],
      "slots": []
    },
    {
      "tag": "ui-editor-slash-menu",
      "package": "@threadlabs/looma/editor",
      "className": "UIEditorSlashMenuElement",
      "description": "Responsive slash-command suggestion surface positioned from an app-provided editor anchor.",
      "attributes": [],
      "properties": [
        { "name": "anchorRect", "type": "DOMRect | null", "default": null },
        { "name": "items", "type": "SlashMenuItem[]", "default": [] },
        { "name": "open", "type": "boolean", "default": false },
        { "name": "query", "type": "string", "default": "" },
        { "name": "selectedIndex", "type": "number", "default": 0 }
      ],
      "events": [
        {
          "name": "looma-editor-slash-menu-highlight",
          "detailType": "SlashMenuHighlightEventDetail",
          "detailSchema": "{ index: number }",
          "detailDocs": "Emitted when pointer navigation changes the highlighted suggestion."
        },
        {
          "name": "looma-editor-slash-menu-select",
          "detailType": "SlashMenuSelectEventDetail",
          "detailSchema": "{ index: number }",
          "detailDocs": "Emitted when the user selects a slash-command suggestion."
        }
      ],
      "slots": []
    },
    {
      "tag": "ui-editor-table-context-menu",
      "package": "@threadlabs/looma/editor",
      "className": "UIEditorTableContextMenuElement",
      "description": "Cell-scoped and structural table action menu with capability-controlled actions.",
      "attributes": [
        { "name": "can-add-column-after", "property": "canAddColumnAfter", "type": "boolean", "default": false },
        { "name": "can-add-column-before", "property": "canAddColumnBefore", "type": "boolean", "default": false },
        { "name": "can-add-row-after", "property": "canAddRowAfter", "type": "boolean", "default": false },
        { "name": "can-add-row-before", "property": "canAddRowBefore", "type": "boolean", "default": false },
        { "name": "can-delete-column", "property": "canDeleteColumn", "type": "boolean", "default": false },
        { "name": "can-delete-row", "property": "canDeleteRow", "type": "boolean", "default": false },
        { "name": "can-delete-table", "property": "canDeleteTable", "type": "boolean", "default": false },
        { "name": "can-merge-cells", "property": "canMergeCells", "type": "boolean", "default": false },
        { "name": "can-split-cell", "property": "canSplitCell", "type": "boolean", "default": false },
        { "name": "cell-background", "property": "cellBackground", "type": "string", "default": "" },
        { "name": "open", "property": "open", "type": "boolean", "default": false }
      ],
      "properties": [],
      "events": [
        {
          "name": "looma-editor-table-action",
          "detailType": "TableContextMenuActionEventDetail",
          "detailSchema": "{ action: TableContextMenuAction }",
          "detailDocs": "Emitted when the user invokes an available table or cell action."
        }
      ],
      "slots": []
    },
    {
      "tag": "ui-editor-table-overlay",
      "package": "@threadlabs/looma/editor",
      "className": "UIEditorTableOverlayElement",
      "description": "Anticipatory table affordances for insertion, row and column selection, and cell actions.",
      "attributes": [
        { "name": "cols", "property": "cols", "type": "number", "default": 3 },
        { "name": "open", "property": "open", "type": "boolean", "default": false },
        { "name": "rows", "property": "rows", "type": "number", "default": 3 }
      ],
      "properties": [
        {
          "name": "geometry",
          "type": "TableOverlayGeometry | null",
          "default": null,
          "description": "Measured table boundaries and active-cell geometry supplied by the editor adapter."
        }
      ],
      "events": [
        {
          "name": "looma-editor-table-overlay-action",
          "detailType": "TableOverlayActionEventDetail",
          "detailSchema": "TableOverlayActionEventDetail",
          "detailDocs": "Emitted for insertion, row or column selection, and active-cell menu intent."
        }
      ],
      "slots": []
    },
    {
      "tag": "ui-editor-table-toolbar",
      "package": "@threadlabs/looma/editor",
      "className": "UIEditorTableToolbarElement",
      "description": "Selection-aware table toolbar for alignment and discoverable structural actions.",
      "attributes": [
        { "name": "can-add-column-after", "property": "canAddColumnAfter", "type": "boolean", "default": false },
        { "name": "can-add-column-before", "property": "canAddColumnBefore", "type": "boolean", "default": false },
        { "name": "can-add-row-after", "property": "canAddRowAfter", "type": "boolean", "default": false },
        { "name": "can-add-row-before", "property": "canAddRowBefore", "type": "boolean", "default": false },
        { "name": "can-delete-column", "property": "canDeleteColumn", "type": "boolean", "default": false },
        { "name": "can-delete-row", "property": "canDeleteRow", "type": "boolean", "default": false },
        { "name": "can-delete-table", "property": "canDeleteTable", "type": "boolean", "default": false },
        { "name": "can-merge-cells", "property": "canMergeCells", "type": "boolean", "default": false },
        { "name": "can-split-cell", "property": "canSplitCell", "type": "boolean", "default": false },
        { "name": "cell-alignment", "property": "cellAlignment", "type": "\"left\" | \"center\" | \"right\"", "default": "left" },
        { "name": "open", "property": "open", "type": "boolean", "default": false }
      ],
      "properties": [],
      "events": [
        {
          "name": "looma-editor-table-action",
          "detailType": "TableContextMenuActionEventDetail",
          "detailSchema": "{ action: TableContextMenuAction }",
          "detailDocs": "Emitted when the user invokes an available table action."
        }
      ],
      "slots": []
    },
    {
      "tag": "ui-editor-toolbar",
      "package": "@threadlabs/looma/editor",
      "className": "UIEditorToolbarElement",
      "description": "Slot-based semantic toolbar shell for app-owned editor commands.",
      "attributes": [],
      "properties": [],
      "events": [],
      "slots": [
        { "name": "default", "description": "App-owned editor command controls." }
      ]
    }
  ]
}
