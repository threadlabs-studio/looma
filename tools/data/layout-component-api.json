        { "name": "min-width", "type": "number", "default": 176 },
        { "name": "max-width", "type": "number", "default": 480 },
        { "name": "resize-step", "type": "number", "default": 16 },
        { "name": "resize-label", "type": "string", "default": "Resize sidebar" }
      ],
      "properties": [
        { "name": "align", "type": "string", "default": "stretch" },
        { "name": "gap", "type": "string", "default": "m" },
        { "name": "side", "type": "string", "default": "start" },
        { "name": "width", "type": "string", "default": "default" },
        { "name": "resizable", "type": "boolean", "default": false }
      ],
      "events": [
        {
          "name": "resize",
          "detailType": "SidebarResizeDetail",
          "detailSchema": "{ width: number; trigger: 'keyboard' | 'pointer' | 'programmatic' }",
          "detailDocs": "Emitted as the side region changes width."
        }
      ],
      "slots": [{ "name": "default", "description": "Exactly two children: side region then content, reversed by side=end." }]
