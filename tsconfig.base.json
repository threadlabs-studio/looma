{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@threadlabs/looma-core": ["packages/core/index.ts"],
      "@threadlabs/looma-core/declarative": ["packages/core/src/declarative.ts"],
      "@threadlabs/looma-core/declarative-generated": ["packages/core/src/declarative-generated.ts"],
      "@threadlabs/looma-core/loader": ["packages/core/src/loader.ts"],
      "@threadlabs/looma-core/valibot": ["packages/core/src/field/valibot.ts"],
      "@threadlabs/looma-editor": ["packages/editor/src/index.ts"],
      "@threadlabs/looma-editor/extensions": ["packages/editor/src/extensions/index.ts"],
      "@threadlabs/looma-editor/ui": ["packages/editor/src/ui.ts"],
      "@threadlabs/looma-layout": ["packages/layout/src/declarative-index.ts"]
    },
    "types": []
  }
}
